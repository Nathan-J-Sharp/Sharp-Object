<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sharp Objects</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="icon" type="image/x-icon" href="images/Sharp.png">
    <link rel="stylesheet" href="/css/stylesheet.css">
    <script src="/main.js" defer></script>
</head>
<body>
    <%- include("./partials/background.ejs") %>
    <%- include("./partials/header.ejs") %>
    <div id="banner">
        <img src="images/product_banner.png" alt="background image">
        <h1>Products</h1>
    </div>
        <main id="product_wrapper">
            <form id="filter_bar" action="/products" method="GET">
                <button id="filter_close" type="button"><span class="line"> </span><span class="line"></span></button>
                <div id="search_bar">       
                    <input id="search" type="text" name="k" placeholder="Search" value="<%= k || '' %>">
                    <button>Search</button>
                </div> 
                <fieldset class="checkboxes">
                    <legend>Categories</legend>

                    <input type="checkbox" name="category" value="toy">
                    <h3>Toys</h3>
                    <input type="checkbox" name="category" value="decoration">
                    <h3>Decoration</h3>
                    <input type="checkbox" name="category" value="jewelry">
                    <h3>Jewelry</h3>
                    <input type="checkbox" name="category" value="cookie-cutter">
                    <h3>Cooke Cutters</h3>
                    <input type="checkbox" name="category" value="seasonal">
                    <h3>Seasonal</h3>
                </fieldset>
            </form>
            <div class="products">
                <% products.forEach(product =>{ %>
                <section class="product">
                    <% if(product.image_url == null) { %>
                        <img src="/images/NO_image.png" alt= "<%= product.name %>">
                    <% } else { %>
                        <img src="<%= product.image_url %>" alt= "<%= product.name %>">
                    <% } %>
                    <a href="/products/<%= product.name%>"><h3><%= product.name %></h3></a>
                    <div class="product_info">
                        <h4><%= product.stock %></h4>
                        <h4>$<%= product.cost %></h4>
                    </div>
                </section>
                <% }) %>
            </div>
            <div id="page-nav">
                <% if (page > 1) { %>
                    <a id="arrow-left-far" href="/products?page=<%= 1 %>&k=<%= k %>">«</a>
                    <a id="arrow-left" href="/products?page=<%= page - 1 %>&k=<%= k %>">←</a>
                <% } %>
                <% if ( totalPages <= 5){ %>
                    <% for(i_page = 1; i_page <= totalPages; i_page++) { %>
                        <% if(i_page == page) { %>
                            <a class="page-num" href=""><%= page %></a>
                        <% } else { %>
                            <a class="page-num" href="/products?page=<%= i_page %>&k=<%= k %>"><%= i_page %></a>
                        <% } %>
                    <% } %>
                <% } else if( page <= 2) { %>
                    <% if( page == 1) { %>
                        <a  class="page-num" href=""><%= page %></a>
                        <a  class="page-num" href="/products?page=<%= page + 1 %>&k=<%= k %>"><%= page + 1 %></a>
                        <a  class="page-num" href="/products?page=<%= page + 2 %>&k=<%= k %>"><%= page + 2 %></a>
                        <a  class="page-num" href="/products?page=<%= page + 1 %>&k=<%= k %>"><%= page + 3 %></a>
                        <a  class="page-num" href="/products?page=<%= page + 2 %>&k=<%= k %>"><%= page + 4 %></a>
                    <% } else {%>
                        <a class="page-num" href="/products?page=<%= page - 1 %>&k=<%= k %>"><%= page - 1 %></a>
                        <a class="page-num" href=""><%= page %></a>
                        <a class="page-num" href="/products?page=<%= page + 1 %>&k=<%= k %>"><%= page + 1 %></a>
                        <a class="page-num" href="/products?page=<%= page + 2 %>&k=<%= k %>"><%= page + 2 %></a>
                        <a class="page-num" href="/products?page=<%= page + 3 %>&k=<%= k %>"><%= page + 3 %></a>
                    <% } %>
                <% } else if( page >= totalPages - 1) {%>
                    <% if( page == totalPages) { %>
                        <a class="page-num" href="/products?page=<%= page - 4 %>&k=<%= k %>"><%= page - 4 %></a>
                        <a class="page-num" href="/products?page=<%= page - 3 %>&k=<%= k %>"><%= page - 3 %></a>
                        <a class="page-num" href="/products?page=<%= page - 2 %>&k=<%= k %>"><%= page - 2 %></a>
                        <a class="page-num" href="/products?page=<%= page - 1 %>&k=<%= k %>"><%= page - 1 %></a>
                        <a class="page-num" href=""><%= page %></a>
                    <% } else {%>
                        <a class="page-num" href="/products?page=<%= page - 3 %>&k=<%= k %>"><%= page - 3 %></a>
                        <a class="page-num" href="/products?page=<%= page - 2 %>&k=<%= k %>"><%= page - 2 %></a>
                        <a class="page-num" href="/products?page=<%= page - 1 %>&k=<%= k %>"><%= page - 1 %></a>
                        <a class="page-num" href=""><%= page %></a>
                        <a class="page-num" href="/products?page=<%= page - 1 %>&k=<%= k %>"><%= page + 1 %></a>
                    <% } %>
                <% } else { %>
                        <a class="page-num" href="/products?page=<%= page - 2 %>&k=<%= k %>"><%= page - 2 %></a>
                        <a class="page-num" href="/products?page=<%= page - 1 %>&k=<%= k %>"><%= page - 1 %></a>
                        <a class="page-num" href=""><%= page %></a>
                        <a class="page-num" href="/products?page=<%= page + 1 %>&k=<%= k %>"><%= page + 1 %></a>
                        <a class="page-num" href="/products?page=<%= page + 2 %>&k=<%= k %>"><%= page + 2 %></a>
                <% } %>

                <% if (page < totalPages) { %>
                    <a id="arrow-right" href="/products?page=<%= page + 1 %>&k=<%= k %>">→</a>
                    <a id="arrow-right-far" href="/products?page=<%= totalPages %>&k=<%= k %>">»</a>
                <% } %>
            </div>
            <div id="custom_print_sect">
            <img id="image_background" src="images/product_custom_banner.png" alt="custom image background">
            <div class="custom_print_msg">
                <h2>Order Custom Prints</h2>
                <p>If you want you own design printed, just order it here.</p>
                <a href="#" id="order">Order Now</a>
            </div>
            </div>
        
        <button id="search_tab_button">🔍</button>
        <script>
            const filter_button = document.querySelector("#search_tab_button")
            const filter_close = document.querySelector("#filter_close")
            const search = document.querySelector("#filter_bar")
            filter_button.addEventListener('click', ()=>{
                search.classList.add('open')
            });

            filter_close.addEventListener('click', ()=>{
                search.classList.remove('open')
            })
        </script>

        </main>
        <%- include("./partials/footer.ejs") %>
</body>
</html>